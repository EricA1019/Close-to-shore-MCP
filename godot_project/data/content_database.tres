[gd_resource type="Resource" script_class="Database" load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/resource_databases/database.gd" id="1_db"]

[resource]
script = ExtResource("1_db")
metadata/_custom_type_script = "res://addons/resource_databases/database.gd"

# Collections
collections = {
	"entities": {
		"dir": "res://data/entities",
		"id_field": "id",
		"title_field": "name",
		"extensions": PackedStringArray(".tres", ".res")
	},
	"abilities": {
		"dir": "res://data/abilities",
		"id_field": "id",
		"title_field": "name",
		"extensions": PackedStringArray(".tres", ".res")
	},
	"statuses": {
		"dir": "res://data/statuses",
		"id_field": "id",
		"title_field": "name",
		"extensions": PackedStringArray(".tres", ".res")
	}
}

roots = PackedStringArray("res://data")

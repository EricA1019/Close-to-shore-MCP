				"engine",
				"ensure",
				"--version",
				"4.5-beta6"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "CTS: DB Index (cache stats)",
			"type": "shell",
			"command": "${workspaceFolder}/rust/target/release/cts",
			"args": [
				"db",
				"index",
				"--project-root",
				"${workspaceFolder}",
				"--roots",
				"res://data",
				"--verify-hash",
				"1.0",
				"--stats-out",
				"${workspaceFolder}/logs/db_index_stats.json"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "CTS: DB Stats → Console",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"test -f logs/db_index_stats.json && jq -r \"Cache: hits=\\(.cache.hits) changed=\\(.cache.changed) deleted=\\(.cache.deleted) verify=\\(.cache.verify_rate) | Timings: discover=\\(.timings.discover_ms)ms hash=\\(.timings.hash_ms)ms parse=\\(.timings.parse_ms)ms total=\\(.timings.total_ms)ms\" logs/db_index_stats.json || echo 'No stats found. Run: CTS: DB Index (cache stats)'"
			],
			"group": "test",
			"problemMatcher": [],
			"dependsOn": ["CTS: DB Index (cache stats)"]
		},

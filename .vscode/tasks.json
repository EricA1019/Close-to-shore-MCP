			"label": "MCP: Start stdlib server",
			"type": "shell",
			"command": "/bin/python3.11",
			"args": [
				"MCP/TOOLS/mcp_server.py"
			],
			"group": "test",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "CTS: DB Search (prompt)",
			"type": "shell",
			"command": "${workspaceFolder}/rust/target/release/cts",
			"args": [
				"db",
				"search",
				"--project-root",
				"${workspaceFolder}",
				"--query",
				"${input:dbSearchQuery}",
				"--roots",
				"res://data,res://addons/resource_databases"
			],
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "CTS: Engine Ensure (4.5b6)",
			"type": "shell",
			"command": "./rust/target/release/cts",
